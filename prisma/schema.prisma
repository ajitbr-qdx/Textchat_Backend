datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(191)
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  chatsInitiated Chat[]    @relation("User1Chats")
  chatsReceived  Chat[]    @relation("User2Chats")
  messages       Message[]

  @@map("users")
}

model Chat {
  id        Int      @id @default(autoincrement())
  user1Id   Int      @map("user1_id")
  user2Id   Int      @map("user2_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user1    User      @relation("User1Chats", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("User2Chats", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("chats")
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int      @map("chat_id")
  senderId  Int      @map("sender_id")
  message   String   @db.Text
  mediaUrl  String?   @map("media_url") @db.VarChar(500)
  status    String    @default("sent") @db.VarChar(20)
  seenAt    DateTime? @map("seen_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
  @@map("messages")
}
