PORT=5000
NODE_ENV=development

# MySQL Database connection URL format:
# mysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql://root:password@localhost:3306/chat_db"

# JWT configuration
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (comma separated or * for all)
CORS_ORIGIN="*"

# Antivirus Scanning (ClamAV)
CLAMAV_ENABLED=true
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60000
# If true, rejects file upload if ClamAV daemon is unreachable. If false, logs warning and allows file.
CLAMAV_BLOCK_ON_FAIL=false
